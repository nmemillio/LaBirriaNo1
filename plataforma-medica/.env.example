# Base de datos PostgreSQL (local en desarrollo; en producción usa Neon,
# Supabase, Vercel Postgres, etc. — cualquier Postgres accesible por URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/galeno?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Login con Google (opcional en desarrollo; sin estas variables el botón de
# Google se oculta automáticamente y solo queda el login normal)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (opcional en desarrollo; sin STRIPE_SECRET_KEY los botones de
# "Suscribirme" muestran un aviso de que Stripe no está configurado)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Almacenamiento de video/PDF en Vercel Blob (opcional en desarrollo; sin
# esta variable los archivos se guardan en disco local bajo storage/)
BLOB_READ_WRITE_TOKEN=""

# Firma de URLs protegidas de video/PDF (streaming propio, ver punto 6 y 11)
CONTENT_SIGNING_SECRET="replace-with-a-long-random-string"
