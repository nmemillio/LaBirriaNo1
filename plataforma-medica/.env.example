# Base de datos (SQLite para desarrollo; en producción usar Postgres)
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Login con Google (opcional en desarrollo; sin estas variables el botón de
# Google se oculta automáticamente y solo queda el login normal)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (opcional en desarrollo; sin STRIPE_SECRET_KEY los botones de
# "Suscribirme" muestran un aviso de que Stripe no está configurado)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Firma de URLs protegidas de video/PDF (streaming propio, ver punto 6 y 11)
CONTENT_SIGNING_SECRET="replace-with-a-long-random-string"
